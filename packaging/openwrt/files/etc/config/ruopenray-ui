config ruopenray-ui 'main'
	option enabled '1'
	option host '0.0.0.0'
	option port '9090'
	option password 'admin'
	option data_dir '/etc/ruopenray-ui'
	option backup_dir '/etc/ruopenray-ui/backups'
	option geo_dir '/usr/share/xray'
	option active_config '/etc/xray/config.json'
	option xray_service 'xray'
	option start_delay '0'
	option apply_delay '0'
	option go_memlimit '48MiB'
	option go_gc '60'
	option download_mirror 'direct'
	option mirror_prefix ''
